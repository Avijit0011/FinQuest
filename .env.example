# Environment
ENV=development

# Database & Cache
DATABASE_URL=postgresql://finquest:finquest_password@localhost:5432/finquest_db
REDIS_URL=redis://localhost:6379/0

# Security Secrets
JWT_SECRET=super-secret-finquest-jwt-key-2026-change-in-prod
JWT_REFRESH_SECRET=super-secret-finquest-refresh-key-2026

# AI Providers Configuration (openai | gemini | nvidia | fallback)
AI_PROVIDER=fallback
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here

# Frontend Environment
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
